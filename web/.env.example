# The paymaster backend. Only THIS server talks to it, so it does not need to be publicly
# reachable — and the browser never needs CORS on it.
#
# 3100 rather than 3000, because this site owns 3000. Inside its container the backend still
# listens on 3000; it is the HOST mapping that moves (`BACKEND_HOST_PORT` in docker-compose.yml).
PAYMASTER_API_URL=http://127.0.0.1:3100

# Privy application id. Must be the SAME app the backend verifies against (its PRIVY_APP_ID), or
# every session this app asks for is refused: the backend checks the token's audience.
#
# Unset renders an explanation rather than a broken login screen — see components/sign-in.tsx.
NEXT_PUBLIC_PRIVY_APP_ID=

# Set to "true" ONLY for local http development. It drops `Secure` from the session cookie, which
# on a real deployment would let the session travel in clear text on the first http request.
# DASHBOARD_INSECURE_COOKIES=true

# PAYMASTER_TIMEOUT_MS=8000

# Deliberately NOT here: PAYMASTER_ADMIN_KEY.
#
# That credential belongs to the operator console (../frontend) and can read and write every
# tenant. This app authenticates as the signed-in CUSTOMER, using a session cookie scoped to their
# own tenant. Keeping the two in separate deployments means a mistake in a customer-facing route
# cannot reach a platform credential, because the credential is not in this process at all.
