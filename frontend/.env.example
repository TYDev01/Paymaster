# Where the paymaster backend is, as reached from THIS server (not from the browser). The console
# proxies every backend call through its own route handlers, which is what keeps the admin key
# server-side and means the backend needs no CORS and no public exposure.
PAYMASTER_API_URL=http://127.0.0.1:3100

# Enables the Policies page. Server-side only — it is never sent to the browser, and the proxy is
# GET-only against an allowlist, so this key cannot be used to mutate anything through the console.
# PAYMASTER_ADMIN_KEY=pm_live_...

# The alert catalogue is read from the repository's own rule file — the same one Prometheus loads
# and the Helm chart injects. Override when the console runs somewhere that file is not adjacent.
# PAYMASTER_ALERT_RULES=/etc/paymaster/alerts.yml

# Per-request timeout when calling the backend.
# PAYMASTER_TIMEOUT_MS=5000
