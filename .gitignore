# Compiler files
cache/
out/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# (forge-doc output, if ever generated, would go here — our hand-written docs/ IS tracked)

# Dotenv file
.env
.env.*
!.env.example

# Secrets. The sponsorship signer key must never reach the repo; in production it lives in a
# KMS/HSM and the backend holds only a reference to it.
*.pem
*.key
keystore/

# Node (backend + SDK land here in later slices)
node_modules/
dist/
coverage/
lcov.info

# Tooling caches and incremental build state. Regenerated from source; never reviewed.
.eslintcache
*.tsbuildinfo
.cache/
.vitest/

# Package-manager debug logs (only written when an install fails)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Helm packaging output and fetched chart dependencies
deploy/helm/**/charts/
deploy/helm/**/*.tgz

# Bundler binary: a 56MB per-platform release artifact, fetched by `npm run bundler:fetch`
# with a pinned version and checksum.
backend/.bundler/

# Generated by deploy/local-setup.sh — contains keys (dev, but do not commit)
deploy/.env.local

# Foundry script broadcast logs
contracts/broadcast/

# Deploy runner state. chains.json names environment-specific RPC env vars; deployments.json and
# chains.env are generated from broadcast receipts. Committing them would put one environment's
# addresses in everyone's tree. chains.example.json is the template and IS committed.
deploy/chains.json
deploy/deployments.json
deploy/chains.env

# OS cruft
.DS_Store
Thumbs.db

# Editor / IDE local state (settings are developer-local; share via docs, not the repo)
.vscode/
.idea/
*.swp
*~

# Frontend build output and the screenshots taken while verifying it.
frontend/.next/
frontend/.shots/
frontend/next-env.d.ts

# Runtime state from ./start.sh: pidfiles and logs.
.run/
